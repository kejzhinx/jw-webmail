[Unit]
Description=JW-Webmail Host PC Backup Agent
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/jw-backup-agent
ExecStart=/usr/bin/node /opt/jw-backup-agent/agent.mjs
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
